// ─────────────────────────────────────────────────────────────
//  UTILITY & SENSORS
// ─────────────────────────────────────────────────────────────
float clampf(float v, float lo, float hi) {
  return (v < lo) ? lo : (v > hi) ? hi : v;
}

int readAnalogAveraged(int pin, uint8_t samples = 10) {
  long total = 0;
  for (uint8_t i = 0; i < samples; i++) {
    total += analogRead(pin);
    delayMicroseconds(200);
  }
  return (int)(total / samples);
}

float readTurbidityNTU() {
  int raw = readAnalogAveraged(TURBIDITY_PIN);
  float ntu = 10.0f - (raw / 409.5f);
  return clampf(ntu, 0.0f, 10.0f);
}

float readPH() {
  int raw    = readAnalogAveraged(PH_PIN);
  float volt = (raw * ADC_VREF) / ADC_MAX;
  float ph   = (volt / PH_SLOPE) + PH_OFFSET;
  return clampf(ph, 0.0f, 14.0f);
}

float readTemperatureC() {
  int raw    = readAnalogAveraged(TEMP_PIN);
  float volt = (raw * ADC_VREF) / ADC_MAX;
  float tempC = volt * TEMP_SCALE_C_PER_V;
  return clampf(tempC, -10.0f, 85.0f);
}

// ─────────────────────────────────────────────────────────────
//  ACTUATORS & PUMPS (WITH SAFETY INTERLOCKS)
// ─────────────────────────────────────────────────────────────

void applyPump(int relayPin, bool state) {
  digitalWrite(relayPin, state ? HIGH : LOW);
}

// FAILSAFE FUNCTION: Prevents opening and closing simultaneously
void applyValve(int openPin, int closePin, bool openState) {
  // 1. Force both pins LOW immediately to break any active circuit
  digitalWrite(openPin, LOW);
  digitalWrite(closePin, LOW);
  
  // 2. Hardware Deadband: Wait 100ms for relays to mechanically detach
  delay(100); 

  // 3. Safely apply the new state
  if (openState) {
    digitalWrite(openPin, HIGH);  // Drive the motor to OPEN
  } else {
    digitalWrite(closePin, HIGH); // Drive the motor to CLOSE
  }
}

void beep(int ms = 200) {
  digitalWrite(BUZZER_PIN, HIGH);
  delay(ms);
  digitalWrite(BUZZER_PIN, LOW);
}

// ─────────────────────────────────────────────────────────────
//  LCD UI
// ─────────────────────────────────────────────────────────────
String padTo(String s, uint8_t width) {
  while (s.length() < width) s += ' ';
  if (s.length() > width) s = s.substring(0, width);
  return s;
}

void lcdCenterPrint(const String &text, uint8_t row, uint8_t width = 20) {
  int pad = (width - (int)text.length()) / 2;
  if (pad < 0) pad = 0;
  String line = "";
  for (int i = 0; i < pad; i++) line += ' ';
  line += text;
  lcd.setCursor(0, row);
  lcd.print(padTo(line, width));
}

void showLCDMsg(const char* line1, const char* line2) {
  lcd.clear();
  lcd.setCursor(0, 1); lcdCenterPrint(line1, 1);
  lcd.setCursor(0, 2); lcdCenterPrint(line2, 2);
  showToggleMsg  = true;
  toggleMsgTime  = millis();
}

void bootScreenInit() {
  lcd.createChar(0, barFull);
  lcd.createChar(1, barEmpty);
  lcd.clear();
  lcdCenterPrint("AquaVise", 0);
  lcdCenterPrint("Smart Aquaculture", 1);
}

void bootProgress(uint8_t pct, const String &status) {
  pct = (pct > 100) ? 100 : pct;
  const uint8_t barWidth = 18;
  uint8_t filled = (uint8_t)((pct / 100.0f) * barWidth);

  lcd.setCursor(1, 2);
  for (uint8_t i = 0; i < barWidth; i++) {
    lcd.write(i < filled ? byte(0) : byte(1));
  }
  String line = status + " " + String(pct) + "%";
  lcdCenterPrint(line, 3);
}

void bootFail(const String &line1, const String &line2) {
  lcd.clear();
  lcdCenterPrint(line1, 1);
  lcdCenterPrint(line2, 2);
}

void updateLCD() {
  if (showToggleMsg && (millis() - toggleMsgTime < TOGGLE_MSG_MS)) return;
  showToggleMsg = false;

  String row0 = "Temp: " + String(realTemperature, 1) + " C";
  if (realTemperature < 24.0 || realTemperature > 28.0) row0 += "  ALRT";
  lcd.setCursor(0, 0);
  lcd.print(padTo(row0, 20));

  String row1 = "pH:   " + String(realPH, 2);
  if (realPH < 6.2 || realPH > 6.8) row1 += "      ALRT";
  lcd.setCursor(0, 1);
  lcd.print(padTo(row1, 20));

  String row2 = "Turb: " + String(realTurbidity, 1) + " NTU";
  if (realTurbidity > turbidityThreshold) row2 += " HIGH";
  lcd.setCursor(0, 2);
  lcd.print(padTo(row2, 20));

  String row3 = "V1:" + String(valve1State      ? "OPN " : "CLS") +
                " V2:" + String(valve2State      ? "OPN " : "CLS") +
                " A:"  + String(aeratorState     ? "ON" : "OF") +
                " R:"  + String(recyclePumpState? "ON" : "OF");
  lcd.setCursor(0, 3);
  lcd.print(padTo(row3, 20));
}

// ─────────────────────────────────────────────────────────────
//  FIREBASE COMMS
// ─────────────────────────────────────────────────────────────
void uploadSensorData() {
  if (!Firebase.ready()) return;
  Firebase.RTDB.setFloat(&fbdo, "/sensors/temperature", realTemperature);
  Firebase.RTDB.setFloat(&fbdo, "/sensors/ph",          realPH);
  Firebase.RTDB.setFloat(&fbdo, "/sensors/turbidity",   realTurbidity);
}

void readInitialPumpStates() {
  if (!Firebase.ready()) return;

  if (Firebase.RTDB.getBool(&fbdo, "/freshwaterPump"))
    valve1State = fbdo.boolData();
  if (Firebase.RTDB.getBool(&fbdo, "/drainPump"))
    valve2State = fbdo.boolData();
  if (Firebase.RTDB.getBool(&fbdo, "/aeratorPump"))
    aeratorState = fbdo.boolData();
  if (Firebase.RTDB.getBool(&fbdo, "/recyclePump"))
    recyclePumpState = fbdo.boolData();
  if (Firebase.RTDB.getFloat(&fbdo, "/turbidityThreshold"))
    turbidityThreshold = fbdo.floatData();

  // Apply safe valve functions on startup
  applyValve(VALVE1_OPEN_PIN, VALVE1_CLOSE_PIN, valve1State);
  applyValve(VALVE2_OPEN_PIN, VALVE2_CLOSE_PIN, valve2State);
  
  applyPump(AERATOR_PIN,      aeratorState);
  applyPump(RECYCLE_PUMP_PIN, recyclePumpState);

  Serial.println("Initial states loaded from Firebase.");
}

void streamCallback(FirebaseStream data) {
  String path = data.dataPath();
  Serial.print("Stream update -> "); Serial.println(path);

  if (path == "/freshwaterPump") {
    bool newState = data.boolData();
    if (newState != valve1State) {
      valve1State = newState;
      applyValve(VALVE1_OPEN_PIN, VALVE1_CLOSE_PIN, valve1State);
      showLCDMsg("Freshwater Valve", valve1State ? "OPENING" : "CLOSING");
      beep(500);
    }
  }
  else if (path == "/drainPump") {
    bool newState = data.boolData();
    if (newState != valve2State) {
      valve2State = newState;
      applyValve(VALVE2_OPEN_PIN, VALVE2_CLOSE_PIN, valve2State);
      showLCDMsg("Drain Valve", valve2State ? "OPENING" : "CLOSING");
      beep(500);
    }
  }
  else if (path == "/aeratorPump") {
    bool newState = data.boolData();
    if (newState != aeratorState) {
      aeratorState = newState;
      applyPump(AERATOR_PIN, aeratorState);
      showLCDMsg("Aerator Pump", aeratorState ? "TURNED ON" : "TURNED OFF");
      beep(500);
    }
  }
  else if (path == "/recyclePump") {
    bool newState = data.boolData();
    if (newState != recyclePumpState) {
      recyclePumpState = newState;
      applyPump(RECYCLE_PUMP_PIN, recyclePumpState);
      showLCDMsg("Recycle Pump", recyclePumpState ? "TURNED ON" : "TURNED OFF");
      beep(500);
    }
  }
  else if (path == "/turbidityThreshold") {
    float newThresh = data.floatData();
    if (newThresh >= 1.0f && newThresh <= 10.0f) {
      turbidityThreshold = newThresh;
      char buf[16];
      snprintf(buf, sizeof(buf), "%.1f NTU", turbidityThreshold);
      showLCDMsg("Threshold Set", buf);
    }
  }
  else if (path == "/" && data.dataType() == "json") {
    readInitialPumpStates();
  }
}

void streamTimeoutCallback(bool timeout) {
  if (timeout) {
    Serial.println("Stream timeout - will reconnect.");
  }
}

