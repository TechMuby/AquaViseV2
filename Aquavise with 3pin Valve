void connectWiFiOrStartPortal() {
  bootProgress(15, "Scanning networks");

  wm.setAPCallback(onConfigPortalStart);
  wm.setSaveConfigCallback(onConfigPortalSaved);
  wm.setConfigPortalTimeout(PORTAL_TIMEOUT_SECONDS);
  wm.setConnectTimeout(15);          
  wm.setBreakAfterConfig(true);      

  bootProgress(30, "Connecting WiFi");

  bool connected = wm.autoConnect(AP_NAME, AP_PASSWORD);

  if (connected) {
    bootProgress(55, "WiFi Connected");
  } else {
    bootFail("Setup Timed Out", "Restarting...");
    delay(2000);
    ESP.restart();
  }
}

// ─────────────────────────────────────────────────────────────
//  SETUP
// ─────────────────────────────────────────────────────────────
void setup() {
  Serial.begin(115200);

  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);

  // Initialize Valve Pins and Pumps
  int outputs[] = {
    VALVE1_OPEN_PIN, VALVE1_CLOSE_PIN, 
    VALVE2_OPEN_PIN, VALVE2_CLOSE_PIN, 
    AERATOR_PIN, RECYCLE_PUMP_PIN, BUZZER_PIN
  };
  
  for (int pin : outputs) {
    pinMode(pin, OUTPUT);
    digitalWrite(pin, LOW); // Ensure everything defaults to OFF/Safe state
  }

  Wire.begin(LCD_SDA, LCD_SCL);
  lcd.init();
  lcd.backlight();
  bootScreenInit();
  bootProgress(5, "Initializing");
  delay(400);

  prefs.begin("aquavise", false);
  connectWiFiOrStartPortal();

  bootProgress(65, "Configuring cloud");
  config.api_key           = FIREBASE_API_KEY;
  config.database_url      = FIREBASE_DATABASE_URL;
  auth.user.email          = FIREBASE_USER_EMAIL;
  auth.user.password       = FIREBASE_USER_PASSWORD;
  config.token_status_callback = tokenStatusCallback;

  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);

  bootProgress(78, "Authenticating");
  unsigned long authStart = millis();
  while (!Firebase.ready() && millis() - authStart < 10000) {
    delay(250);
  }

  if (Firebase.ready()) {
    firebaseReady = true;
    bootProgress(90, "Syncing data");
    
    readInitialPumpStates();

    if (!Firebase.RTDB.beginStream(&fbStream, "/")) {
      Serial.println("Stream begin failed: " + fbStream.errorReason());
    } else {
      Firebase.RTDB.setStreamCallback(&fbStream, streamCallback, streamTimeoutCallback);
      streamStarted = true;
    }

    realTurbidity   = readTurbidityNTU();
    realPH          = readPH();
    realTemperature = readTemperatureC();
    uploadSensorData();

    bootProgress(100, "Ready");
  } else {
    bootProgress(90, "Cloud offline");
    delay(800);
    bootProgress(100, "Starting locally");
  }

  delay(900);
  lcd.clear();
}

// ─────────────────────────────────────────────────────────────
//  LOOP
// ─────────────────────────────────────────────────────────────
void loop() {
  unsigned long now = millis();

  if (Firebase.ready()) {
    if (!firebaseReady) {
      firebaseReady = true;
      readInitialPumpStates();
    }
    if (!streamStarted) {
      if (Firebase.RTDB.beginStream(&fbStream, "/")) {
        Firebase.RTDB.setStreamCallback(&fbStream, streamCallback, streamTimeoutCallback);
        streamStarted = true;
      }
    }
  } else {
    firebaseReady = false;
    streamStarted = false;
  }

  if (now - lastTurbRead > TURB_READ_MS) {
    realTurbidity = readTurbidityNTU();
    lastTurbRead  = now;
  }
  if (now - lastPHRead > PH_READ_MS) {
    realPH = readPH();
    lastPHRead = now;
  }
  if (now - lastTempRead > TEMP_READ_MS) {
    realTemperature = readTemperatureC();
    lastTempRead = now;
  }

  if (now - lastSensorUpload > SENSOR_UPLOAD_MS) {
    uploadSensorData();
    lastSensorUpload = now;
  }

  if (now - lastLCDUpdate > LCD_INTERVAL_MS) {
    updateLCD();
    lastLCDUpdate = now;
  }
}
